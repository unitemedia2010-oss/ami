# =============================================================================
#  .gitignore — KHÔNG BAO GIỜ commit bí mật hay dữ liệu cào
#
#  Bài học từ lần chuẩn bị đầu tiên: thư mục này có 171 MB dữ liệu bất
#  động sản cào từ trang khác. Git KHÔNG giới hạn kích thước repo, nhưng
#  push 171 MB lên GitHub rất chậm và làm mọi lần clone về sau nặng nề.
#  Dữ liệu đó được sinh lại được bằng script, không cần lưu trong git.
# =============================================================================

# ---- bí mật --------------------------------------------------------------
.env
.env.local
.env*.local
.dev.vars
*.pem
*.key

# ---- build ---------------------------------------------------------------
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# ---- dữ liệu bất động sản cào từ nguồn khác ----------------------------
# KHÔNG đưa lên Git: dữ liệu của bên thứ ba, dung lượng lớn, có thể kéo
# dài hạn về sau.
#
# ⚠ KHÔNG dùng `*.json` để chặn. Lần trước đã dùng, và nó nuốt luôn
#   web/tsconfig.json — file khai báo alias `@/`. Bản clone từ GitHub build
#   fail sau 7 giây với hàng loạt:
#       Module not found: Can't resolve '@/components/ui'
#   Mà trên máy vẫn build bình thường vì file có sẵn. Nếu chặn theo mẫu
#   rộng, mọi file cấu hình .json sau này cũng sẽ biến mất lặng lẽ.
#   Chặn ĐÚNG TỪNG FILE là an toàn hơn nhiều.
/all-enriched.json
/all-listings.json
/all-merged.json
/pass-gia-asc.json
/pass-gia-desc.json
/thu-thiem.json
/thu-thiem-can-ho.json
/thu-thiem.csv
*.csv
*.xlsx
*.xls
raw/
logs/
*.log

# ---- dự án khác đang nằm chung thư mục ---------------------------------
JD_UNITEGROUP/

# ---- file nhạy cảm từng lưu nhầm ---------------------------------------
.token
cookies.txt
*-cookies.txt
*-crawled*
scrape-full.log

# ---- hệ điều hành / IDE -------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/