# =============================================================================
#  Biến môi trường cho website
#
#  Sao chép file này thành `.env.local` rồi điền giá trị thật.
#  `.env.local` KHÔNG được commit lên Git.
#  Trên GitHub Pages, biến PUBLIC_ được nhúng vào bundle lúc build —
#  nên chỉ đặt các khoá ANON (dùng công khai, an toàn khi nằm trong trình duyệt).
# =============================================================================

# ---- Supabase (anon key: công khai, có thể nằm trong trình duyệt) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- API Gateway (Cloudflare Worker) ----
NEXT_PUBLIC_API_URL=https://api.bds.example.com

# ---- Cloudflare Turnstile (site key công khai) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAABBBBBBBBBB

# ---- Đường dẫn (BẮT BUỘC khi deploy) --------------------------------------
# Tiền tố đường dẫn của trang.
#   • Trang nằm ở https://<tai-khoan>.github.io/ami  →  NEXT_PUBLIC_BASE_PATH=/ami
#   • Trang đã gắn tên miền riêng (https://tenmien.vn/)  →  để TRỐNG
#   • Chạy local trên cổng 8787                          →  để TRỐNG
# Thiếu hoặc sai giá trị này thì HTML mở được nhưng mọi ảnh và file
# _next/*.js đều trả 404 → trang trắng.
NEXT_PUBLIC_BASE_PATH=/ami

# Địa chỉ trang đầy đủ, dùng cho canonical, sitemap và chia sẻ mạng xã hội
NEXT_PUBLIC_SITE_URL=https://unitemedia2010-oss.github.io/ami

# ---- Chế độ dữ liệu --------------------------------------------------------
# Để API_URL trống = trang đọc thẳng file JSON trong web/public/data/.
# Đó là chế độ đang chạy trên GitHub Pages hiện tại.
# Khi nối Worker/Supabase thì điền URL thật, KHÔNG cần sửa code giao diện.