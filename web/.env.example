# =============================================================================
#  Biến môi trường cho website
#
#  Sao chép file này thành `.env.local` rồi điền giá trị thật.
#  `.env.local` KHÔNG được commit lên Git.
#  Trên GitHub Pages, biến PUBLIC_ được nhúng vào bundle lúc build —
#  nên chỉ đặt các khoá ANON (dùng công khai, an toàn khi nằm trong trình duyệt).
# =============================================================================

# ---- Supabase (anon key: công khai, có thể nằm trong trình duyệt) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- API Gateway (Cloudflare Worker) ----
NEXT_PUBLIC_API_URL=https://api.bds.example.com

# ---- Cloudflare Turnstile (site key công khai) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAABBBBBBBBBB